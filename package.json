    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.0",
    "@napi-rs/canvas": "^0.1.80",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "//pins": {
    "typescript": "Held at 6.x on purpose. TypeScript 7 (the Go rewrite) is out, but typescript-eslint does not support it yet and eslint-config-next crashes on load. Revisit once typescript-eslint ships TS 7 support.",
    "eslint": "Held at 9.x on purpose. eslint-config-next 16.3 bundles an eslint-plugin-react that calls context.getFilename(), removed in ESLint 10."
  }
